import fmt

type Person struct {
    name string
    age int
}

impl Person {
    pub fn new(string name, int age) Person {
        return Person {
            name: name,
            age: age,
        }
    }

    pub fn info(self) string {
        return "person"
    }
}

fn main() {
    var p = Person("小明", 18)

    fmt.println(p.info())
}