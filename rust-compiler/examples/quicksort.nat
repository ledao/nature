// QuickSort implementation in Nature language

fn partition(arr: [i32], low: i32, high: i32) -> i32 {
    let pivot = arr[high];
    let i = low - 1;
    
    for j in low..high {
        if arr[j] <= pivot {
            i = i + 1;
            let temp = arr[i];
            arr[i] = arr[j];
            arr[j] = temp;
        }
    }
    
    let temp = arr[i + 1];
    arr[i + 1] = arr[high];
    arr[high] = temp;
    
    return i + 1;
}

fn quicksort(arr: [i32], low: i32, high: i32) {
    if low < high {
        let pi = partition(arr, low, high);
        quicksort(arr, low, pi - 1);
        quicksort(arr, pi + 1, high);
    }
}

fn main() {
    let arr = [64, 34, 25, 12, 22, 11, 90];
    let n = arr.length;
    
    println("Original array:");
    for i in 0..n {
        print("{} ", arr[i]);
    }
    println("");
    
    quicksort(arr, 0, n - 1);
    
    println("Sorted array:");
    for i in 0..n {
        print("{} ", arr[i]);
    }
    println("");
    
    return 0;
}
