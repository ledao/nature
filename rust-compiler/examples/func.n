// Function call test
// Demonstrates Nature language function definition and calling

from fmt import println

func test_print() {
    println("This is a test function")
}

func test_print2() {
    println("This is another test function")
}

func add(int a, int b) {
    var result = a + b
    return result
}

func main() {
    println("=== Function Call Test ===")
    
    // Test function calls
    test_print()
    test_print2()
    
    // Test add function
    println("Testing add function:")
    
    var sum = add(10, 20)
    println("10 + 20 =", sum)
    println("Direct call result:", add(10, 20))
    
    println("=== Test Complete ===")
}