fn test_print() {
    print("Hello ");
    println("World!");
    println("Numbers: ", 42, " and ", 3.14);
}

fn test_len() {
    var text = "Hello Nature";
    var length = len(text);
    println("Length of '", text, "' is ", length);
    text = "Hello Nature, again";
    length = len(text);
    println("Length of '", text, "' is ", length);
}

fn main() {
    test_print();
    test_len();
}
